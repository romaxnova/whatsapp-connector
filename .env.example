# Copy to .env and fill in (docker compose and npm run dev read it). On Railway, set these in the service's
# Variables tab instead: BASE_URL and DATA_DIR are then found by themselves.

# Public https address of this server, without a path. Not needed on Railway or Render.
BASE_URL=https://whatsapp.example.com

# Password for the admin page (linking WhatsApp) and for approving Claude. At least 12 characters.
ADMIN_PASSWORD=

# 32-byte key that encrypts the WhatsApp session and the message index. Generate both secrets with
# "npm run generate-secrets". Keep a copy: without it the stored data is lost and WhatsApp must be linked again.
TOKEN_ENCRYPTION_KEY=

# Host name(s) of your G-Spot Assistant, so WhatsApp files can be sent to its Drive and Gmail (comma-separated).
PEER_UPLOAD_HOSTS=connector-production.up.railway.app

# Optional. Defaults shown.
# DEFAULT_TIMEZONE=UTC                # IANA zone the times are shown in, e.g. Europe/Paris
# FULL_HISTORY=true                   # ask the phone for its full history when linking
# MESSAGE_RETENTION_DAYS=0            # forget messages older than this (0 keeps everything)
# PORT=8080
# DATA_DIR=/data
# MCP_PATH=/mcp
# SERVER_NAME=WhatsApp Connector
# LOG_LEVEL=info                      # debug | info | warn | error
# TRUST_PROXY=1
# DCR_ENABLED=true
# CIMD_ALLOWED_HOSTS=claude.ai
# EXTRA_REDIRECT_URIS=
# ANTHROPIC_IP_LOCK=false
# TOKEN_ENCRYPTION_KEY_PREVIOUS=
